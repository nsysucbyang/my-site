Notebook[{
Cell[TextData[{
  "The standard Mathematica system consists of two parts:\n",
  StyleBox["\[KernelIcon]",
    FontSize->24],
  "  The kernel\[LongDash]which actually does computations",
  StyleBox["\n", "LineSpace"],
  StyleBox["\[MathematicaIcon]",
    FontSize->24],
  "  The front end\[LongDash]which handles user interaction and notebooks."
}], "GrayBox",
  CellTags->"T.11"],

Cell[TextData[ButtonBox[
"Help-Mathematica Book-Reference Guide-Installation and Organization of \
System files",
  ButtonData:>{
    "C:\\Program Files\\Wolfram \
Research\\Mathematica\\3.0\\Documentation\\English\\MainBook\\A_08.nb", 
    "3.1"},
  ButtonStyle->"Hyperlink"]], "Text"],

Cell[TextData[
"\[ShiftKey]-\[EnterKey] Evaluate the whole current cell\n\[ShiftKey]-\
\[ControlKey]-\[EnterKey] Evalutate selected express in place"], "GrayBox"],

Cell["\<\
%  last result generated
%...%(k times)  the kthe previous result
%n  the result in Out[n]\
\>", "GrayBox"],

Cell[TextData[
"ways to enter character :\n\[FilledSquare] Enter it directly (e.g. Pi)\n\
\[FilledSquare] Enter it by full name (e.g. \\[Pi ] )\n\[FilledSquare] Enter \
it by alias (e.g. \[EscapeKey]Pi\[EscapeKey] = \[AliasDelimiter]Pi \
\[AliasDelimiter] = \[AliasDelimiter]\\Pi \[AliasDelimiter] ) (notebook only)\
\n\[FilledSquare] Enter it by choosing from pallete (notebook only)\n\
\[FilledSquare] Enter it by character code ~ \\nnn, \\.nn, \\:nnnn (e.g. \
\\053) "], "GrayBox"],

Cell["\<\
Numbers :
2^101.111`200*^6
b^^n`t(``t)*^e ~ number n, precision (accuracy) t, base b, exponent e\
\>", "GrayBox"],

Cell[TextData[{
  "2D vs. 1D exparess :\ne.g. x^y = ",
  Cell[BoxData[
      \(TraditionalForm\`x\^y\)]],
  "\n Noet : x y = x*y \[NotEqual] xy"
}], "Text"],

Cell[TextData[
"4 braketing:\n\[FilledSquare] (term) paratheses for grouping\n\
\[FilledSquare] f[x] squar brakets for function\n\[FilledSquare] {x,y,z} \
curly braces for lists\n\[FilledSquare] v[[a,b]] double brakets for \
indexing"], "GrayBox"],

Cell["\<\
<< name
<< context`
ReadList [ \"file\", formate ]
exp >> name
exp >>> name
Save[ \"file\",f,g,...]
!! file
!command
Directory[]
SetDirectory[]\
\>", "GrayBox"],

Cell[TextData[{
  "\[FilledSmallSquare] ",
  StyleBox["Module[", "MR"],
  Cell[BoxData[
      \(TraditionalForm\`{\)], "InlineFormula"],
  StyleBox["x", "TI"],
  StyleBox[",", "MR"],
  " ",
  StyleBox["y", "TI"],
  StyleBox[",", "MR"],
  " \[Ellipsis] ",
  Cell[BoxData[
      \(TraditionalForm\`}\)], "InlineFormula"],
  StyleBox[",", "MR"],
  " ",
  StyleBox["expr", "TI"],
  StyleBox["]", "MR"],
  " specifies that occurrences of the symbols ",
  StyleBox["x", "TI"],
  ", ",
  StyleBox["y", "TI"],
  ", \[Ellipsis]  in ",
  StyleBox["expr", "TI"],
  " should be treated as local. \n\[FilledSmallSquare] ",
  StyleBox["Module[", "MR"],
  Cell[BoxData[
      \(TraditionalForm\`{\)], "InlineFormula"],
  StyleBox["x", "TI"],
  " ",
  StyleBox["=", "MR"],
  " ",
  Cell[BoxData[
      FormBox[
        SubscriptBox[
          "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"x\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "0"], TraditionalForm]], "InlineFormula"],
  StyleBox[",", "MR"],
  " \[Ellipsis] ",
  Cell[BoxData[
      \(TraditionalForm\`}\)], "InlineFormula"],
  StyleBox[",", "MR"],
  " ",
  StyleBox["expr", "TI"],
  StyleBox["]", "MR"],
  " defines initial values for ",
  StyleBox["x", "TI"],
  ", \[Ellipsis] . \n\n\[FilledSmallSquare] ",
  StyleBox["With[", "MR"],
  Cell[BoxData[
      \(TraditionalForm\`{\)], "InlineFormula"],
  StyleBox["x", "TI"],
  " ",
  StyleBox["=", "MR"],
  " ",
  Cell[BoxData[
      FormBox[
        SubscriptBox[
          "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"x\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "0"], TraditionalForm]], "InlineFormula"],
  StyleBox[",", "MR"],
  " ",
  StyleBox["y", "TI"],
  " ",
  StyleBox["=", "MR"],
  " ",
  Cell[BoxData[
      FormBox[
        SubscriptBox[
          "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"y\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "0"], TraditionalForm]], "InlineFormula"],
  StyleBox[",", "MR"],
  " \[Ellipsis] ",
  Cell[BoxData[
      \(TraditionalForm\`}\)], "InlineFormula"],
  StyleBox[",", "MR"],
  " ",
  StyleBox["expr", "TI"],
  StyleBox["]", "MR"],
  " specifies that in ",
  StyleBox["expr", "TI"],
  " occurrences of the symbols ",
  StyleBox["x", "TI"],
  ", ",
  StyleBox["y", "TI"],
  ", \[Ellipsis]  should be replaced by ",
  Cell[BoxData[
      FormBox[
        SubscriptBox[
          "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"x\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "0"], TraditionalForm]], "InlineFormula"],
  ", ",
  Cell[BoxData[
      FormBox[
        SubscriptBox[
          "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"y\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "0"], TraditionalForm]], "InlineFormula"],
  ", \[Ellipsis] . \n\n\[FilledSmallSquare] ",
  StyleBox["Block[", "MR"],
  Cell[BoxData[
      \(TraditionalForm\`{\)], "InlineFormula"],
  StyleBox["x", "TI"],
  StyleBox[",", "MR"],
  " ",
  StyleBox["y", "TI"],
  StyleBox[",", "MR"],
  " \[Ellipsis] ",
  Cell[BoxData[
      \(TraditionalForm\`}\)], "InlineFormula"],
  StyleBox[",", "MR"],
  " ",
  StyleBox["expr", "TI"],
  StyleBox["]", "MR"],
  " specifies that ",
  StyleBox["expr", "TI"],
  " is to be evaluated with local values for the symbols ",
  StyleBox["x", "TI"],
  ", ",
  StyleBox["y", "TI"],
  ", \[Ellipsis] . \n\[FilledSmallSquare] ",
  StyleBox["Block[", "MR"],
  Cell[BoxData[
      \(TraditionalForm\`{\)], "InlineFormula"],
  StyleBox["x", "TI"],
  " ",
  StyleBox["=", "MR"],
  " ",
  Cell[BoxData[
      FormBox[
        SubscriptBox[
          "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"x\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "0"], TraditionalForm]], "InlineFormula"],
  StyleBox[",", "MR"],
  " \[Ellipsis] ",
  Cell[BoxData[
      \(TraditionalForm\`}\)], "InlineFormula"],
  StyleBox[",", "MR"],
  " ",
  StyleBox["expr", "TI"],
  StyleBox["]", "MR"],
  " defines initial local values for ",
  StyleBox["x", "TI"],
  ", \[Ellipsis] . \n\n\[FilledSmallSquare] These constructs can be nested in \
any way. \n\[FilledSmallSquare] ",
  StyleBox["Module", "MR"],
  " implements lexical scoping.\n\[FilledSmallSquare] ",
  StyleBox["With", "MR"],
  " implements read only lexical variables. \n\[FilledSmallSquare] ",
  StyleBox["Block", "MR"],
  " implements dynamic scoping of variables. \n",
  "When lexical scoping is used, variables are treated as local to a \
particular section of the ",
  StyleBox["code", "TI"],
  " in a program. \nIn dynamic scoping, the values of variables are local to \
a part of the ",
  StyleBox["execution history", "TI"],
  " of the program. "
}], "GrayBox"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(t = 1\), 
    \(Module[{t}, t = 9; t]\), 
    \(t\)}], "Input"],

Cell[BoxData[
    \(1\)], "Output"],

Cell[BoxData[
    \(9\)], "Output"],

Cell[BoxData[
    \(1\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(t\), 
    \(With[{t = 5}, t + Sin[t]]\), 
    \(t\)}], "Input"],

Cell[BoxData[
    \(1\)], "Output"],

Cell[BoxData[
    \(5 + Sin[5]\)], "Output"],

Cell[BoxData[
    \(1\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(m = i\^2; \nModule[{i = a}, i + m]\), 
    \(Block[{i = a}, i + m]\)}], "Input"],

Cell[BoxData[
    \(a + i\^2\)], "Output"],

Cell[BoxData[
    \(a + a\^2\)], "Output"]
}, Open  ]],

Cell["\<\
Use notion of \"contexts\" to organize the names of symbols.
 c1`c2`...`name
 `c1`c2`...`name
 Constext[s]\tcontext of symbol s
 $Constext\tcurrent context
 $ContextPath\tcontext search path\
\>", "GrayBox"],

Cell["\<\
Clear[s]\tclear the values of a symbol
Remove[s]\tremove a symbol completely from the system\
\>", "GrayBox"],

Cell["\<\
Needs[\"context`\"]\tread in package if the specified context is not already \
in $Packages
DeclarePackage[\"context`\",{name1,...}]\tdeclare that a package should \
automatically be loaded if a symbol with any of the names namei is used
BeginPackage[\"Package`\",{\"Needed1\",...}]\tset Package` to be the current \
context, and put  System` and contexts needed on the context search path
f::usage=\"text\",...\tintroduce the objects intended for exprot (and no \
others)
Begin[\"`Private\"]\tSwitch to a new current context (Package`Private`)
f[args]=...\tmain body of definitions in the package
End[]\trevert to the previous context (Package`)
EndPackage[]\tend the package, prepending the Package` to the context search \
path\
\>", "GrayBox"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(<< DiscreteMath`ComputationalGeometry`\), 
    \(data2D\  = 
      \ {{4.4, \ 14}, \ {6.7, \ 15.25}, \n\ {6.9, \ 12.8}, \ {2.1, \ 11.1}, 
